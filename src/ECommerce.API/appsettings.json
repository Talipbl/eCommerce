{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ECommerce": ""
  },
  "Jwt": {
    "Issuer": "ecommerce-api",
    "Audience": "ecommerce-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seed": {
    "Admin": {
      "UserName": "",
      "Password": "",
      "Email": ""
    }
  },
  "Checkout": {
    "ShippingFee": 49.90,
    "FreeShippingThreshold": 750,
    "CashOnDeliveryFee": 19.90,
    "BankTransfer": {
      "BankName": "",
      "AccountHolder": "",
      "Iban": ""
    }
  },
  "Media": {
    "RootPath": "media",
    "PublicBaseUrl": ""
  },
  "Trendyol": {
    "BaseUrl": "https://apigw.trendyol.com",
    "SellerId": "",
    "ApiKey": "",
    "ApiSecret": "",
    "BatchPolling": {
      "Enabled": true,
      "IntervalSeconds": 60
    },
    "InventorySync": {
      "Enabled": true,
      "IntervalSeconds": 60
    },
    "OrderImport": {
      "Enabled": true,
      "IntervalSeconds": 300
    },
    "OrderStatusSync": {
      "Enabled": true,
      "IntervalSeconds": 60
    }
  }
}
