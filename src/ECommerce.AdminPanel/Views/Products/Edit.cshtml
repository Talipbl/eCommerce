@model ProductEditPage
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    ViewData["Brands"] = Model.Brands;
    ViewData["Categories"] = Model.Categories;
    var images = Model.Images;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="me-auto">
        <a asp-action="Index" class="small">← Ürünler</a>
        <h1 class="h3 mb-0">@product.Name</h1>
    </div>
    <span class="badge fs-6 @(product.IsActive ? "text-bg-success" : "text-bg-secondary")">@(product.IsActive ? "Yayında" : "Taslak")</span>
    @if (product.IsActive)
    {
        <form method="post" asp-action="Unpublish" asp-route-id="@product.Id" data-confirm="Ürün sitede görünmeyecek. Devam edilsin mi?">
            <button type="submit" class="btn btn-outline-secondary">Yayından kaldır</button>
        </form>
    }
    else
    {
        <form method="post" asp-action="Publish" asp-route-id="@product.Id">
            <button type="submit" class="btn btn-success">Yayınla</button>
        </form>
    }
    <form method="post" asp-action="Delete" asp-route-id="@product.Id" data-confirm="@product.Name ürünü silinsin mi? Bu işlem geri alınamaz.">
        <button type="submit" class="btn btn-outline-danger">Sil</button>
    </form>
</div>

<section class="card mb-3" aria-labelledby="details-title">
    <div class="card-body">
        <h2 id="details-title" class="h5 card-title">Ürün bilgileri</h2>
        <form method="post" asp-action="Edit" asp-route-id="@product.Id" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <partial name="_DetailsFields" for="Details" view-data="ViewData" />
            <button type="submit" class="btn btn-primary mt-3">Bilgileri kaydet</button>
        </form>
    </div>
</section>

<section class="card mb-3" aria-labelledby="variants-title">
    <div class="card-body">
        <h2 id="variants-title" class="h5 card-title">Varyantlar</h2>
        <p class="text-body-secondary small">Stok kodu ve barkod sonradan değiştirilemez. Pasif varyant sitede ve pazaryerinde satılmaz.</p>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Stok kodu / Barkod</th><th>Satış fiyatı</th><th>Liste fiyatı</th><th>Stok</th><th>Özellikler</th><th>Aktif</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var variant in product.Variants)
                    {
                        var formId = $"variant-{variant.Id}";
                        <tr>
                            <td>
                                <div>@variant.Sku</div>
                                <div class="small text-body-secondary">@variant.Barcode</div>
                            </td>
                            <td><input form="@formId" name="Price" type="number" step="0.01" min="0" class="form-control form-control-sm" value="@variant.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Satış fiyatı" /></td>
                            <td><input form="@formId" name="ListPrice" type="number" step="0.01" min="0" class="form-control form-control-sm" value="@variant.ListPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Liste fiyatı" /></td>
                            <td><input form="@formId" name="StockQuantity" type="number" min="0" class="form-control form-control-sm" value="@variant.StockQuantity" aria-label="Stok" /></td>
                            <td><textarea form="@formId" name="AttributesText" rows="2" class="form-control form-control-sm" aria-label="Özellikler">@VariantAttributesText.Format(variant.Attributes)</textarea></td>
                            <td>
                                <input form="@formId" name="IsActive" type="checkbox" value="true" class="form-check-input" checked="@variant.IsActive" aria-label="Aktif" />
                                <input form="@formId" name="IsActive" type="hidden" value="false" />
                            </td>
                            <td class="text-nowrap">
                                <form id="@formId" method="post" asp-action="UpdateVariant" asp-route-id="@product.Id" asp-route-variantId="@variant.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Kaydet</button>
                                </form>
                                <form method="post" asp-action="RemoveVariant" asp-route-id="@product.Id" asp-route-variantId="@variant.Id" class="d-inline"
                                      data-confirm="@variant.Sku varyantı silinsin mi?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3 class="h6 mt-3">Yeni varyant</h3>
        <form method="post" asp-action="AddVariant" asp-route-id="@product.Id" novalidate>
            <partial name="_VariantFields" for="NewVariant" />
            <button type="submit" class="btn btn-outline-primary mt-3">Varyant ekle</button>
        </form>
    </div>
</section>

<section class="card mb-3" aria-labelledby="images-title">
    <div class="card-body">
        <h2 id="images-title" class="h5 card-title">Görseller <span class="text-body-secondary small">(@images.Count / @ProductEditPage.MaxImages)</span></h2>
        <p class="text-body-secondary small">İlk görsel listede ve pazaryerinde ana görsel olarak kullanılır. Sürükleyerek veya oklarla sıralayın.</p>

        @if (images.Count > 0)
        {
            <form method="post" asp-action="ReorderImages" asp-route-id="@product.Id">
                <ol class="image-grid mb-2" data-sortable>
                    @for (var i = 0; i < images.Count; i++)
                    {
                        var image = images[i];
                        <li class="card">
                            <input type="hidden" name="imageIds" value="@image.Id" />
                            <img src="@image.Url" alt="@image.AltText" class="card-img-top" loading="lazy" />
                            <div class="card-body p-2 d-flex gap-1">
                                <button type="submit" name="move" value="@image.Id:-1" class="btn btn-sm btn-outline-secondary" disabled="@(i == 0)" aria-label="Öne al">←</button>
                                <button type="submit" name="move" value="@image.Id:1" class="btn btn-sm btn-outline-secondary" disabled="@(i == images.Count - 1)" aria-label="Arkaya al">→</button>
                                <button type="submit" formaction="@Url.Action("DeleteImage", new { id = product.Id, imageId = image.Id })"
                                        class="btn btn-sm btn-outline-danger ms-auto" data-confirm="Görsel silinsin mi?">Sil</button>
                            </div>
                        </li>
                    }
                </ol>
                <button type="submit" class="btn btn-sm btn-primary" data-sortable-save hidden>Sırayı kaydet</button>
            </form>
        }

        @if (images.Count < ProductEditPage.MaxImages)
        {
            <form method="post" asp-action="UploadImage" asp-route-id="@product.Id" enctype="multipart/form-data" class="row g-2 align-items-end mt-2">
                <div class="col-12 col-md-5">
                    <label for="file" class="form-label small">Görsel (JPEG, PNG veya WebP, en fazla 5 MB)</label>
                    <input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" required />
                </div>
                <div class="col-12 col-md-5">
                    <label for="altText" class="form-label small">Alternatif metin</label>
                    <input id="altText" name="altText" class="form-control" placeholder="Görselde ne var?" />
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">Yükle</button>
                </div>
            </form>
        }
    </div>
</section>
