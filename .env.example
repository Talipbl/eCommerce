# .env olarak kopyalayın ve değerleri doldurun. .env dosyası git'e eklenmez.
# Değerlerde ; $ " ' karakterlerini kullanmayın.

# Veritabanı (en az 8 karakter; büyük/küçük harf, rakam, sembolden en az üçü)
MSSQL_SA_PASSWORD=

# JWT imza anahtarı (en az 32 bayt, rastgele)
JWT_SIGNING_KEY=

# Trendyol — boş bırakılırsa Prod. Stage: https://stageapigw.trendyol.com
TRENDYOL_BASE_URL=
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# İlk yönetici (opsiyonel; parola en az 12 karakter, büyük/küçük harf ve rakam içermeli)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=

# Havale/EFT bilgileri (müşteriye gösterilir)
BANK_NAME=
BANK_ACCOUNT_HOLDER=
BANK_IBAN=
# Yayındaki alan adı; Caddy bu ad için HTTPS sertifikası alır (yerel test: localhost)
DOMAIN=

# SQL Server sürümü: Express (ücretsiz, 10 GB) / Web / Standard (lisans gerekir)
MSSQL_PID=Express

# Sunucuda çekilecek image etiketi: latest, sha-<kısa commit> veya 1.2.0
IMAGE_TAG=latest

# Yedekleme betiğinin yedekleri saklama süresi (gün)
BACKUP_KEEP_DAYS=14
