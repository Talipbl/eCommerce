@model CategoryFormModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Yeni kategori" : "Kategoriyi düzenle";
}

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>

        <form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentId" class="form-label"></label>
                <select asp-for="ParentId" class="form-select"
                        asp-items="@(new SelectList(Model.ParentOptions, nameof(CategoryOption.Id), nameof(CategoryOption.IndentedName)))">
                    <option value="">(Kök kategori)</option>
                </select>
                <span asp-validation-for="ParentId" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6 col-sm-4">
                    <label asp-for="SortOrder" class="form-label"></label>
                    <input asp-for="SortOrder" class="form-control" type="number" />
                    <span asp-validation-for="SortOrder" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-6 col-sm-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a class="btn btn-link" asp-action="Index">Vazgeç</a>
        </form>
    </div>
</div>
