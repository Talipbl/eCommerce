@model IReadOnlyList<BrandDto>
@{
    ViewData["Title"] = "Markalar";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-auto">Markalar</h1>
    <form method="get" asp-action="Index" class="d-flex gap-2" role="search">
        <input type="search" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Marka ara" aria-label="Marka ara" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>
    <a class="btn btn-primary" asp-action="Create">Yeni marka</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">Marka bulunamadı.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Ad</th><th>Slug</th><th>Durum</th><th class="text-end">İşlemler</th></tr>
            </thead>
            <tbody>
                @foreach (var brand in Model)
                {
                    <tr>
                        <td>@brand.Name</td>
                        <td><code>@brand.Slug</code></td>
                        <td><span class="badge @(brand.IsActive ? "text-bg-success" : "text-bg-secondary")">@Display.ActiveLabel(brand.IsActive)</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@brand.Id">Düzenle</a>
                            <form method="post" asp-action="Delete" asp-route-id="@brand.Id" class="d-inline"
                                  data-confirm="@brand.Name markası silinsin mi?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
