@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Parola değiştir";
}

<div class="row">
    <div class="col-12 col-md-6 col-lg-4">
        <h1 class="h4 mb-3">Parola değiştir</h1>
        <p class="text-body-secondary small">Parola değişince tüm cihazlardaki oturumlar kapanır ve tekrar giriş yapmanız gerekir.</p>

        <form method="post" asp-action="ChangePassword" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="invalid-feedback d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary">Parolayı değiştir</button>
        </form>
    </div>
</div>
