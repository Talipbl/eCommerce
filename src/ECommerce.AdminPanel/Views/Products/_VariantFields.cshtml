@model VariantForm

<div class="row g-3">
    <div class="col-12 col-md-6 col-lg-3">
        <label asp-for="Sku" class="form-label"></label>
        <input asp-for="Sku" class="form-control" />
        <span asp-validation-for="Sku" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <label asp-for="Barcode" class="form-label"></label>
        <input asp-for="Barcode" class="form-control" />
        <span asp-validation-for="Barcode" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-6 col-lg-2">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" inputmode="decimal" />
        <span asp-validation-for="Price" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-6 col-lg-2">
        <label asp-for="ListPrice" class="form-label"></label>
        <input asp-for="ListPrice" class="form-control" type="number" step="0.01" min="0" inputmode="decimal" />
        <span asp-validation-for="ListPrice" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-6 col-lg-2">
        <label asp-for="StockQuantity" class="form-label"></label>
        <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
        <span asp-validation-for="StockQuantity" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-12">
        <label asp-for="AttributesText" class="form-label"></label>
        <textarea asp-for="AttributesText" class="form-control" rows="2"></textarea>
        <div class="form-text">Her satıra bir özellik: <code>Beden: M</code></div>
        <span asp-validation-for="AttributesText" class="invalid-feedback d-block"></span>
    </div>
</div>
