@model ProductDetailsForm
@{
    var brands = (IReadOnlyList<BrandDto>)ViewData["Brands"]!;
    var categories = (IReadOnlyList<CategoryOption>)ViewData["Categories"]!;
}

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-12 col-lg-4">
        <label asp-for="ProductCode" class="form-label"></label>
        <input asp-for="ProductCode" class="form-control" />
        <span asp-validation-for="ProductCode" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-12 col-lg-8">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" />
        <span asp-validation-for="Slug" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-6 col-lg-4">
        <label asp-for="VatRate" class="form-label"></label>
        <select asp-for="VatRate" class="form-select" asp-items="@(new SelectList(ProductDetailsForm.VatRates))"></select>
        <span asp-validation-for="VatRate" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="BrandId" class="form-label"></label>
        <select asp-for="BrandId" class="form-select" asp-items="@(new SelectList(brands, nameof(BrandDto.Id), nameof(BrandDto.Name)))">
            <option value="">Seçin</option>
        </select>
        <span asp-validation-for="BrandId" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select"
                asp-items="@(new SelectList(categories, nameof(CategoryOption.Id), nameof(CategoryOption.IndentedName)))">
            <option value="">Seçin</option>
        </select>
        <span asp-validation-for="CategoryId" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
    </div>
</div>
