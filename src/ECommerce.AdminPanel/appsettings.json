{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "",
    "TimeoutSeconds": 30
  },
  "Media": {
    "PublicBaseUrl": ""
  },
  "DataProtection": {
    "KeysPath": ""
  }
}
